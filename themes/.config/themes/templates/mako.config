# GLOBAL
max-history=100
sort=-time

# STYLE OPTIONS
font="Jetbrains Mono", 11
width=300
height=100
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

background-color=${mako_bg}
text-color=${mako_fg}
border-color=${mako_border}
progress-color=over ${mako_progress}

[urgency=low]
border-color=${mako_low}
default-timeout=2000

[urgency=normal]
border-color=${mako_normal}
default-timeout=5000

[urgency=high]
border-color=${mako_high}
text-color=${mako_high_text}
default-timeout=0

[category=mpd]
border-color=${mako_cat}
default-timeout=2000
group-by=category
