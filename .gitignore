# ignore everything in the vscode folder
vscode/*
.claude

# except settings.json & keybindings.json
!vscode/.config/Code/User/settings.json
!vscode/.config/Code/User/keybindings.json

# theme-switcher: generated colour fragments + runtime state
waybar/.config/waybar/colors.css
alacritty/.config/alacritty/colors.toml
quickshell/.config/quickshell/bar/Colors.qml
themes/.config/themes/current
themes/.config/themes/.wallpaper-state
themes/.config/themes/.wallpaper-pid

